{
  "name": "zoomix-site",
  "version": "0.1.0",
  "private": true,
  "description": "ZOOMIX creative partner website built with React, Vite, Tailwind CSS, GSAP, and Lenis.",
  "keywords": [
    "zoomix",
    "creative-partner",
    "website",
    "react",
    "vite",
    "tailwindcss",
    "gsap",
    "scrolltrigger",
    "lenis",
    "animation",
    "branding"
  ],
  "license": "MIT",
  "author": "ZOOMIX",
  "homepage": "https://zoomixegypt.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/zoomixegypt/Zoomix-Egypt.git"
  },
  "bugs": {
    "url": "https://github.com/zoomixegypt/Zoomix-Egypt/issues"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "lenis": "^1.3.17",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.1"
  },
  "scripts": {
    "test:main-site": "node scripts/test-main-site.mjs && node scripts/test-brief-submit.mjs && node scripts/test-browser-storage.mjs && node scripts/test-brief-whatsapp.mjs",
    "test:studio": "node scripts/test-studio.mjs && node scripts/test-commercial.mjs && node scripts/test-studio-matrix.mjs && node scripts/test-studio-display.mjs",
    "test:studio:matrix": "node scripts/test-studio-matrix.mjs",
    "start": "vite --host 0.0.0.0",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prepare-pages-routes.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "dev:cf": "npm run build && wrangler pages dev --port 8788",
    "db:local": "wrangler d1 migrations apply zoomix-studio --local",
    "check": "npm run build && npm audit --omit=dev",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "browserslist": {
    "production": [
      "Chrome >= 111",
      "Edge >= 111",
      "Firefox >= 128",
      "Safari >= 16.4",
      "iOS >= 16.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-react": "^6.0.1",
    "@tailwindcss/vite": "4.3.3",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "4.3.3",
    "vite": "^8.0.8"
  }
}
