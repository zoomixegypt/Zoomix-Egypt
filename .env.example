# Zoomix environment variables (EXAMPLE)
#
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env
#
# These variables are optional and are not required for the public website.
#
# ─────────────────────────────────────────────────────────────────
# ⚠️  SECURITY WARNING — read before deploying ⚠️
# Vite inlines every VITE_* / REACT_APP_* variable into the CLIENT BUNDLE, so any
# key set here is shipped to the browser and is PUBLICLY READABLE on a deployed
# site. This is DEMO-ONLY. For production, do NOT expose a private key here — use a
# server-side / serverless proxy that holds the key as a server secret.
# See docs/ai-terminal.md and SECURITY.md.
# ─────────────────────────────────────────────────────────────────

# Optional AI integration key (server-side use only):
VITE_CEREBRAS_API_KEY=

# Optional Google Analytics 4 Measurement ID (for example: G-XXXXXXXXXX).
# Analytics loads only after the visitor accepts measurement in the consent banner.
VITE_GA_MEASUREMENT_ID=G-XWCZXLJ14C

# Legacy key name, if an existing local integration still uses it:
# REACT_APP_CEREBRAS_API_KEY=
